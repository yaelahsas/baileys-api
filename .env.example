# Api host and port
HOST=127.0.0.1
PORT=9999

# Number retry to connect to whatsapp -1 for infinite
MAX_RETRIES=-1

# Reconnect interval in milliseconds (base delay, exponential backoff will be applied)
RECONNECT_INTERVAL=5000

# Keep-alive interval in milliseconds (sends presence update to keep connection alive)
KEEP_ALIVE_INTERVAL=25000

# Connection check interval in milliseconds (monitors connection health)
CONNECTION_CHECK_INTERVAL=60000

# Maximum consecutive failed keep-alive pings before forcing reconnect
MAX_FAILED_PINGS=3

# Stale connection timeout in milliseconds (5 minutes default - no successful ping = stale)
STALE_CONNECTION_TIMEOUT=300000

# Docker auto-restart: how many consecutive unhealthy healthcheck checks
# before forcing process.exit(1) to trigger Docker restart
# Docker checks /health every 30s, so 3 = 90s unhealthy before restart
DOCKER_UNHEALTHY_RESTART_THRESHOLD=3

# Authentication
AUTHENTICATION_GLOBAL_AUTH_TOKEN=change_this_to_your_token

# Authentication
AUTHENTICATION_GLOBAL_AUTH_TOKEN=change_this_to_your_token

# WEBHOOK CONFIGURATION
# Set to 'false' to disable all webhook sending
APP_WEBHOOK_ENABLED=false
APP_WEBHOOK_URL="https://webhook.site/dbf387ed-a861-4ae9-9b30-9344c972cb74"
APP_WEBHOOK_ALLOWED_EVENTS=MESSAGES_UPSERT,MESSAGES_DELETE,MESSAGES_UPDATE
APP_WEBHOOK_FILE_IN_BASE64=false

# AUTO READ MESSAGES
# Set to 'true' to automatically mark incoming messages as read
AUTO_READ_MESSAGES=true

# API CONFIGURATION
# Base URL for the external API
API_BASE_URL=http://sim-mtsn.test/api
# API key for authentication
API_KEY=whatsapp_bot_key_2024
# Request timeout in milliseconds (30 seconds)
API_TIMEOUT=30000
# Maximum retry attempts for API requests
API_MAX_RETRIES=3
# Delay between retries in milliseconds
API_RETRY_DELAY=2000

# AUTHORIZED NUMBERS FOR BOT COMMANDS
# Comma-separated list of phone numbers with country code (no spaces, no +)
# Example: 6285212870484,6283853399847
AUTHORIZED_NUMBERS=6285212870484,6283853399847

# MESSAGE STORE
# Use sqlite in production for indexed pagination and bounded memory usage.
# Set memory to roll back to the legacy JSON store.
MESSAGE_STORE_TYPE=memory
# Delete SQLite messages older than this many days. Set 0 to disable pruning.
MESSAGE_RETENTION_DAYS=90
